{
  "info": {
    "name": "Практическая работа № 2 — Express Tasks API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3002"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Проверка сервера",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Создание задачи",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman task\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Проверка ответа', () => {",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.be.a('string');",
              "  pm.expect(task.title).to.eql('Postman task');",
              "  pm.expect(task.done).to.eql(false);",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/api/tasks/' + task.id);",
              "  pm.collectionVariables.set('taskId', task.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Список задач",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().some(task => task.id === pm.collectionVariables.get('taskId'))).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Чтение задачи",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('taskId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Обновление задачи",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Postman task\",\n  \"done\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('taskId'));",
              "  pm.expect(pm.response.json().title).to.eql('Updated Postman task');",
              "  pm.expect(pm.response.json().done).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Проверка сохранения изменений",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().done).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Проверка валидации",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \" \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().error).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Некорректный JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().error).to.eql('Invalid JSON');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Удаление задачи",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Чтение после удаления",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().error).to.eql('Task not found');",
              "  pm.collectionVariables.unset('taskId');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Несуществующий маршрут",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/unknown"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Проверка ответа', () => {",
              "  pm.expect(pm.response.json().error).to.eql('Route not found');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
